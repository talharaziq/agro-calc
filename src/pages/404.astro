---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Сторінку не знайдено — Агро Калькулятори" description="Цієї сторінки немає. Перейдіть до всіх агрокалькуляторів або поверніться на головну сторінку." path="/404/" noindex={true}>
  <main id="main-content" class="page-shell" style="min-height:55vh;display:grid;align-content:center;padding-top:3rem;padding-bottom:3rem;">
    <p class="eyebrow">Помилка 404</p>
    <h1 style="font-size:clamp(2.5rem,7vw,4rem);color:#183f2e;line-height:1.05;margin:0;">Такої сторінки немає</h1>
    <p style="font-size:1.08rem;color:#657267;max-width:620px;">Можливо, адресу змінено або ви перейшли за старим посиланням. Відкрийте потрібний калькулятор зі списку.</p>
    <div class="hero-actions"><a class="button-primary" href="/kalkulyatory/">Усі калькулятори</a><a class="button-secondary" href="/">На головну</a></div>
  </main>
</BaseLayout>
