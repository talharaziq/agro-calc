---
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolCard from '../components/ToolCard.astro';
import { tools } from '../data/tools';
import { articles } from '../data/articles';

const featuredSlugs = ['norma-vysivu', 'norma-dobryv', 'robochyi-rozchyn', 'ploshcha-polya', 'vytrata-palnoho', 'produktyvnist-tekhniky', 'vartist-dobryv', 'urozhainist'];
const featuredTools = featuredSlugs.map((slug) => tools.find((tool) => tool.slug === slug)).filter(Boolean);
const homeSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Агро Калькулятори — онлайн-розрахунки для фермерів',
  url: new URL('/', Astro.site ?? 'https://agrocalculator.pp.ua').toString(),
  inLanguage: 'uk-UA',
  description: '26 україномовних калькуляторів для норм висіву культур, добрив, поливу, обприскування, урожайності та економіки господарства.',
};
---
<BaseLayout
  title="Агро Калькулятори — онлайн-розрахунки для фермерів України"
  description="Безкоштовні агрокалькулятори українською для посіву, добрив, обприскування, вимірювання площі, витрати пального й планування польових робіт."
  path="/"
  keywords={['агрокалькулятор', 'агро калькулятори', 'калькулятор норми висіву', 'норма висіву пшениці', 'калькулятор добрив на гектар', 'калькулятор вартості насіння', 'калькулятор площі поля']}
  schema={homeSchema}
>
  <main id="main-content">
    <section class="hero">
      <div class="page-shell hero-inner">
        <div>
          <p class="eyebrow">Практичні інструменти для господарства</p>
          <h1>Агро калькулятори для щоденної роботи в полі</h1>
          <p class="hero-copy">Порахуйте насіння, добрива, робочий розчин, пальне та витрати на поле. Без реєстрації, зайвих таблиць і складних налаштувань.</p>
          <div class="hero-actions">
            <a class="button-primary" href="/kalkulyatory/">Обрати калькулятор <span aria-hidden="true">→</span></a>
            <a class="button-secondary" href="/blog/">Читати практичні поради</a>
          </div>
          <p class="hero-note">Введені дані обробляються у вашому браузері.</p>
        </div>
        <svg class="field-illustration" viewBox="0 0 430 330" role="img" aria-labelledby="field-title field-desc">
          <title id="field-title">Сходи зернових на полі</title>
          <desc id="field-desc">Проста ілюстрація зелених польових рядків і колосся на тлі сонця.</desc>
          <circle cx="309" cy="78" r="43" fill="#e7c56e" />
          <path d="M27 202c66-39 130-45 196-24s119 14 180-22v125H27Z" fill="#b4c99b" />
          <path d="M27 226c70-28 135-29 203-8s119 7 173-19v82H27Z" fill="#8ead76" />
          <path d="M27 251c70-16 137-16 205-2s114 6 171-8v40H27Z" fill="#477d52" />
          <g fill="none" stroke="#2d6240" stroke-width="5" stroke-linecap="round">
            <path d="M93 244V146m0 28c-25 1-34-12-35-29 20 0 33 10 35 29Zm0-18c22-1 31-15 29-30-18 2-28 12-29 30Zm0-29c-18-2-25-13-22-26 14 2 22 11 22 26Z" />
            <path d="M161 238V122m0 43c-26 0-38-14-37-32 21 1 34 12 37 32Zm0-20c23-1 34-15 33-32-20 1-32 12-33 32Zm0-30c-18-2-27-14-24-28 15 2 23 12 24 28Z" />
            <path d="M245 230V137m0 38c-21 1-31-11-31-26 18 0 28 10 31 26Zm0-21c20 0 29-13 28-27-17 1-27 10-28 27Z" />
          </g>
          <g fill="none" stroke="#b88728" stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
            <path d="M93 146l-13-13m13 3 13-14m-13 1-12-14m12 5 12-15m-12 2-8-13m8 6 8-14" />
            <path d="M161 122l-13-13m13 3 13-14m-13 1-12-14m12 5 12-15m-12 2-8-13m8 6 8-14" />
            <path d="M245 137l-11-11m11 2 11-12m-11-1-9-11m9 3 10-12" />
          </g>
          <path d="M26 282c98-17 235-16 379 0" stroke="#d9e5c8" stroke-width="3" fill="none" />
        </svg>
      </div>
    </section>

    <section class="trust-strip" aria-label="Переваги калькуляторів">
      <div class="page-shell trust-grid">
        <div class="trust-item"><span class="trust-dot" aria-hidden="true">✓</span><div><strong>Без реєстрації</strong><span>Відкрийте сторінку й одразу рахуйте.</span></div></div>
        <div class="trust-item"><span class="trust-dot" aria-hidden="true">↗</span><div><strong>Зрозумілі формули</strong><span>Пояснюємо, звідки береться результат.</span></div></div>
        <div class="trust-item"><span class="trust-dot" aria-hidden="true">⌁</span><div><strong>Для телефона й комп’ютера</strong><span>Великі поля та просте керування.</span></div></div>
      </div>
    </section>

    <section class="section">
      <div class="page-shell">
        <div class="section-heading">
          <div><p class="eyebrow">Інструменти</p><h2>Основні калькулятори для господарства</h2><p>Базові інструменти для посіву, живлення, обприскування, вимірювання площі та планування витрат.</p></div>
          <a class="text-link" href="/kalkulyatory/">Усі 26 калькуляторів →</a>
        </div>
        <div class="tool-grid">
          {featuredTools.map((tool) => <ToolCard tool={tool} />)}
        </div>
        <div style="margin-top: 1rem; display: flex; justify-content: flex-end;"><a class="button-secondary" href="/kalkulyatory/">Переглянути всі калькулятори</a></div>
      </div>
    </section>

    <section class="section" style="background:#f2f3e9; border-top:1px solid #e5e8dd; border-bottom:1px solid #e5e8dd;">
      <div class="page-shell content-grid">
        <div>
          <p class="eyebrow">Як користуватися</p>
          <h2 style="margin:0; color:#193e2b; font-size:clamp(1.7rem,3vw,2.2rem); line-height:1.15; letter-spacing:-.04em;">Менше ручних підрахунків — більше ясності в плані робіт</h2>
          <p style="color:#627064; margin:1rem 0;">Калькулятори зроблені для звичайних господарських задач. Вони допомагають перерахувати задані норми, оцінити потребу на площу й побачити результат у звичних одиницях.</p>
          <ol class="info-list">
            <li>Відкрийте потрібний інструмент.</li>
            <li>Введіть свої показники та одиниці виміру.</li>
            <li>Натисніть кнопку розрахунку й перевірте підсумок.</li>
            <li>За потреби скопіюйте або роздрукуйте результат.</li>
          </ol>
        </div>
        <div class="info-panel">
          <h3>Важливо для точного результату</h3>
          <p>Калькулятор правильно порахує введені числа, але не може знати всі умови конкретного поля.</p>
          <ul class="info-list">
            <li>Перевіряйте сертифікат насіння та маркування добрив.</li>
            <li>Використовуйте фактичні площі й витрати свого господарства.</li>
            <li>Дози препаратів звіряйте з етикеткою та регламентом.</li>
            <li>Не сприймайте приклади у формі як агрономічну рекомендацію.</li>
          </ul>
          <p style="margin-top:1rem;"><a class="text-link" href="/vidmova-vid-vidpovidalnosti/">Читайте умови використання розрахунків →</a></p>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="page-shell">
        <div class="section-heading">
          <div><p class="eyebrow">Практичні матеріали</p><h2>Пояснення формул і польових розрахунків</h2><p>Короткі статті про норми висіву, добрива та робочий розчин.</p></div>
          <a class="text-link" href="/blog/">Усі статті →</a>
        </div>
        <div class="article-grid">
          {articles.slice(0, 3).map((article) => (
            <a class="article-card" href={`/blog/${article.slug}/`}>
              <span class="article-date">{article.category} · {article.readTime}</span>
              <h2>{article.title}</h2>
              <p>{article.excerpt}</p>
              <span class="read-more">Читати статтю →</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section-tight">
      <div class="page-shell">
        <div class="cta-panel">
          <div><h2>Маєте конкретне питання щодо розрахунку?</h2><p>Перегляньте відповіді про норму висіву, добрива, площу поля, пальне та продуктивність техніки.</p></div>
          <a class="button-secondary" href="/faq/">Переглянути FAQ</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
