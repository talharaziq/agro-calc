---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ToolCard from '../../components/ToolCard.astro';
import { articles, getArticle } from '../../data/articles';
import { tools, getTool } from '../../data/tools';

export function getStaticPaths() {
  return articles.map((article) => ({ params: { slug: article.slug }, props: { article } }));
}
const { article } = Astro.props;
const relatedTools = article.relatedTools.map((slug: string) => getTool(slug)).filter(Boolean);
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.title,
  description: article.metaDescription,
  datePublished: article.datePublished,
  dateModified: article.datePublished,
  inLanguage: 'uk-UA',
  mainEntityOfPage: new URL(`/blog/${article.slug}/`, Astro.site ?? 'https://agrocalculator.pp.ua').toString(),
  publisher: { '@type': 'Organization', name: 'Агро Калькулятори', url: (Astro.site ?? new URL('https://agrocalculator.pp.ua')).toString() },
};
const formattedDate = new Intl.DateTimeFormat('uk-UA', { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date(`${article.datePublished}T12:00:00`));
---
<BaseLayout title={article.metaTitle} description={article.metaDescription} path={`/blog/${article.slug}/`} type="article" publishedTime={article.datePublished} keywords={[article.category, 'агрономічні розрахунки', 'агрокалькулятори', article.title.toLowerCase()]} schema={articleSchema}>
  <main id="main-content" class="page-shell">
    <section class="page-intro">
      <Breadcrumbs items={[{ label: 'Головна', href: '/' }, { label: 'Блог', href: '/blog/' }, { label: article.title }]} />
      <p class="eyebrow">{article.category} · {article.readTime}</p>
      <h1>{article.title}</h1>
      <p>{article.intro}</p>
      <p style="font-size:.83rem;color:#788378;margin-top:.8rem;">Оновлено: <time datetime={article.datePublished}>{formattedDate}</time></p>
    </section>
    <div class="content-grid section-tight">
      <article class="prose">
        {article.sections.map((section) => <section>
          <h2>{section.heading}</h2>
          {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          {section.bullets && <ul>{section.bullets.map((bullet) => <li>{bullet}</li>)}</ul>}
        </section>)}
        <h2>Корисні калькулятори</h2>
        <p>Використайте інструмент нижче, щоб виконати власний розрахунок за даними господарства.</p>
        <ul>{relatedTools.map((tool) => <li><a href={`/kalkulyatory/${tool!.slug}/`}>{tool!.title}</a></li>)}</ul>
        <p>Перегляньте також <a href="/faq/">часті запитання про агрокалькулятори</a> або <a href="/kalkulyatory/">усі доступні розрахунки</a>.</p>
      </article>
      <aside>
        <div class="info-panel">
          <h3>У цій статті</h3>
          <ul class="info-list">{article.sections.map((section) => <li>{section.heading}</li>)}</ul>
          <p style="font-size:.82rem;margin-top:1rem;">Цей матеріал пояснює арифметику. Агрономічні рішення приймайте на підставі даних конкретного поля та рекомендацій фахівців.</p>
        </div>
      </aside>
    </div>
    {relatedTools.length > 0 && <section class="section-tight">
      <div class="section-heading"><div><p class="eyebrow">Перейти до розрахунку</p><h2>Пов’язані калькулятори</h2></div></div>
      <div class="tool-grid">{relatedTools.map((tool) => <ToolCard tool={tool!} />)}</div>
    </section>}
  </main>
</BaseLayout>
