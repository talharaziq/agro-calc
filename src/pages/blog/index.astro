---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { articles } from '../../data/articles';
const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Блог «Агро Калькулятори»',
  description: 'Пояснення формул і практичні матеріали для розрахунку норм висіву, добрив та робочого розчину.',
  inLanguage: 'uk-UA',
  blogPost: articles.map((article) => ({ '@type': 'BlogPosting', headline: article.title, url: new URL(`/blog/${article.slug}/`, Astro.site ?? 'https://agrocalculator.pp.ua').toString(), datePublished: article.datePublished })),
};
---
<BaseLayout title="Блог для фермерів — норми висіву, добрива та польові розрахунки" description="Практичні статті українською про норму висіву пшениці, перерахунок діючої речовини добрив і розрахунок робочого розчину для обприскування." path="/blog/" keywords={['блог для фермерів', 'норма висіву пшениці', 'розрахунок добрив', 'робочий розчин обприскувача']} schema={blogSchema}>
  <main id="main-content" class="page-shell">
    <section class="page-intro">
      <Breadcrumbs items={[{ label: 'Головна', href: '/' }, { label: 'Блог' }]} />
      <p class="eyebrow">Практичний довідник</p>
      <h1>Блог: агрономічні розрахунки без зайвих складнощів</h1>
      <p>Пояснюємо формули й одиниці виміру, які потрібні для планування посіву, добрив і польових робіт. Матеріали допомагають перевірити арифметику; конкретні норми звіряйте з умовами господарства.</p>
    </section>
    <section class="section-tight">
      <div class="article-grid">
        {articles.map((article) => <a class="article-card" href={`/blog/${article.slug}/`}>
          <span class="article-date">{article.category} · {article.readTime}</span>
          <h2>{article.title}</h2>
          <p>{article.excerpt}</p>
          <span class="read-more">Читати статтю →</span>
        </a>)}
      </div>
    </section>
    <section class="section-tight">
      <div class="note-box">Нові матеріали варто додавати за конкретними питаннями з поля: норми для різних культур, одиниці виміру, контроль витрат і приклади розрахунку з перевіреними джерелами. Не публікуйте неперевірені рекомендації лише заради ключових слів.</div>
    </section>
  </main>
</BaseLayout>
