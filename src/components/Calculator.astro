---
const { kind, title, slug = '' } = Astro.props as { kind: string; title: string; slug?: string };
type CalcField = { id: string; label: string; value: number; min?: number; max?: number; step?: string; help: string };
const fieldSets: Record<string, CalcField[]> = {
  'sowing-rate': [
    { id: 'targetDensity', label: 'Бажана густота, рослин/м²', value: 400, min: 0.01, help: 'Лише приклад. Визначте цільову густоту для своїх умов.' },
    { id: 'thousandSeedMass', label: 'Маса 1000 насінин, г', value: 40, min: 0.01, help: 'Замініть показником із документації конкретної партії.' },
    { id: 'germination', label: 'Лабораторна схожість, %', value: 95, min: 0.01, max: 100, help: 'Використайте результат аналізу партії.' },
    { id: 'purity', label: 'Чистота насіння, %', value: 99, min: 0.01, max: 100, help: 'Перевірте паспорт або сертифікат партії.' },
    { id: 'fieldGermination', label: 'Польова схожість, %', value: 85, min: 0.01, max: 100, help: 'Введіть власну оцінку, а не універсальне значення.' },
    { id: 'rowSpacing', label: 'Міжряддя, см', value: 15, min: 0.1, help: 'Фактична ширина міжряддя.' },
    { id: 'area', label: 'Площа поля, га', value: 10, min: 0.01, help: 'Площа запланованого посіву.' },
    { id: 'reserve', label: 'Страховий запас, %', value: 0, min: 0, max: 100, help: 'Необов’язкова поправка, не агрономічна рекомендація.' },
  ],
  'fertilizer-rate': [
    { id: 'nutrient', label: 'Потреба в діючій речовині, кг/га', value: 80, min: 0.01, help: 'Норма з вашого плану живлення.' },
    { id: 'content', label: 'Вміст речовини в добриві, %', value: 46, min: 0.01, max: 100, help: 'Перевірте маркування продукту.' },
    { id: 'area', label: 'Площа, га', value: 100, min: 0.01, help: 'Площа внесення.' },
  ],
  'spray-solution': [
    { id: 'area', label: 'Площа обробки, га', value: 50, min: 0.01, help: 'Площа запланованої обробки.' },
    { id: 'productRate', label: 'Норма препарату, л або кг/га', value: 1, min: 0, help: 'Одиниця залежить від маркування.' },
    { id: 'waterRate', label: 'Норма робочої рідини, л/га', value: 150, min: 0.01, help: 'Використовуйте задану норму з технологічного плану.' },
    { id: 'tankCapacity', label: 'Місткість бака, л', value: 3000, min: 0.01, help: 'Місткість одного бака.' },
  ],
  'field-area': [
    { id: 'length', label: 'Довжина ділянки, м', value: 100, min: 0.01, help: 'Довжина прямокутної ділянки.' },
    { id: 'width', label: 'Ширина ділянки, м', value: 100, min: 0.01, help: 'Ширина прямокутної ділянки.' },
  ],
  'fuel-cost': [
    { id: 'area', label: 'Площа робіт, га', value: 50, min: 0.01, help: 'Площа відповідної операції.' },
    { id: 'consumption', label: 'Витрата пального, л/га', value: 12, min: 0.01, help: 'Використайте фактичну витрату за цієї операції.' },
    { id: 'price', label: 'Ціна пального, грн/л', value: 55, min: 0, help: 'Введіть ціну власної закупівлі.' },
  ],
  'machinery-productivity': [
    { id: 'width', label: 'Робоча ширина, м', value: 6, min: 0.01, help: 'Робоча ширина агрегату.' },
    { id: 'speed', label: 'Робоча швидкість, км/год', value: 8, min: 0.01, help: 'Не транспортна швидкість.' },
    { id: 'efficiency', label: 'Використання часу, %', value: 75, min: 0.01, max: 100, help: 'Оцініть розвороти, заправки та простої.' },
    { id: 'area', label: 'Площа поля, га', value: 50, min: 0.01, help: 'Площа для розрахунку часу.' },
  ],
  'fertilizer-cost': [
    { id: 'rate', label: 'Норма добрива, кг/га', value: 150, min: 0, help: 'Норма конкретного продукту.' },
    { id: 'price', label: 'Ціна за тонну, грн/т', value: 25000, min: 0, help: 'Введіть фактичну ціну.' },
    { id: 'yield', label: 'Очікувана врожайність, т/га', value: 6, min: 0.01, help: 'Використовується для перерахунку на тонну врожаю.' },
    { id: 'area', label: 'Площа, га', value: 50, min: 0.01, help: 'Площа внесення.' },
  ],
  'yield': [
    { id: 'harvest', label: 'Зібраний урожай, т', value: 300, min: 0, help: 'Маса за вашою системою обліку.' },
    { id: 'area', label: 'Фактично зібрана площа, га', value: 50, min: 0.01, help: 'Не планова, а фактично зібрана площа.' },
  ],
  'seed-cost': [
    { id: 'rate', label: 'Норма висіву, кг/га', value: 80, min: 0.01, help: 'Використайте норму для конкретної культури й партії.' },
    { id: 'price', label: 'Ціна насіння, грн/т', value: 42000, min: 0, help: 'Ціна закупівлі за тонну.' },
    { id: 'area', label: 'Площа поля, га', value: 50, min: 0.01, help: 'Площа запланованого посіву.' },
  ],
  'plant-population': [
    { id: 'rowSpacing', label: 'Міжряддя, см', value: 70, min: 0.1, help: 'Відстань між сусідніми рядками.' },
    { id: 'plantSpacing', label: 'Відстань у рядку, см', value: 25, min: 0.1, help: 'Відстань між рослинами в одному рядку.' },
    { id: 'area', label: 'Площа, га', value: 10, min: 0.01, help: 'Площа для підрахунку загальної кількості.' },
  ],
  'irrigation-water': [
    { id: 'area', label: 'Площа поливу, га', value: 10, min: 0.01, help: 'Площа, на яку планується подати воду.' },
    { id: 'depth', label: 'Шар поливу, мм', value: 10, min: 0.01, help: 'Один міліметр на гектар відповідає 10 м³.' },
    { id: 'efficiency', label: 'Ефективність системи, %', value: 85, min: 0.01, max: 100, help: 'Приклад припущення; замініть своїм значенням.' },
  ],
  'nozzle-flow': [
    { id: 'rate', label: 'Норма робочої рідини, л/га', value: 150, min: 0.01, help: 'Задана норма робочої рідини.' },
    { id: 'speed', label: 'Швидкість руху, км/год', value: 8, min: 0.01, help: 'Робоча швидкість обприскування.' },
    { id: 'nozzleSpacing', label: 'Крок форсунок, см', value: 50, min: 0.1, help: 'Відстань між форсунками на штанзі.' },
    { id: 'nozzles', label: 'Кількість форсунок, шт.', value: 24, min: 1, step: '1', help: 'Кількість форсунок, які працюють одночасно.' },
  ],
  'harvest-loss': [
    { id: 'sampleMass', label: 'Маса зерна зі зразка, г', value: 30, min: 0, help: 'Маса зерна, зібраного з контрольної площі.' },
    { id: 'sampleArea', label: 'Площа зразка, м²', value: 1, min: 0.01, help: 'Площа, з якої зібрано зразок.' },
    { id: 'grainPrice', label: 'Ціна зерна, грн/т', value: 8000, min: 0, help: 'Ціна для оцінки економічного еквівалента.' },
  ],
  'grain-moisture': [
    { id: 'mass', label: 'Початкова маса, т', value: 100, min: 0.001, help: 'Фактична маса партії.' },
    { id: 'currentMoisture', label: 'Поточна вологість, %', value: 20, min: 0, max: 99.99, help: 'Вологість за результатом вимірювання.' },
    { id: 'targetMoisture', label: 'Цільова вологість, %', value: 14, min: 0, max: 99.99, help: 'Цільове значення для математичного перерахунку.' },
  ],
  'crop-profit': [
    { id: 'yield', label: 'Урожайність, т/га', value: 5, min: 0.001, help: 'Прикладове значення; використайте власний сценарій.' },
    { id: 'price', label: 'Ціна реалізації, грн/т', value: 8000, min: 0, help: 'Ціна без автоматичного прогнозування ринку.' },
    { id: 'costs', label: 'Враховані витрати, грн/га', value: 28000, min: 0, help: 'Зазначте, які саме витрати включено.' },
    { id: 'area', label: 'Площа, га', value: 50, min: 0.01, help: 'Площа господарства для цього сценарію.' },
  ],
  'break-even-yield': [
    { id: 'costPerHa', label: 'Витрати, грн/га', value: 30000, min: 0, help: 'Витрати, які має покрити дохід.' },
    { id: 'price', label: 'Ціна реалізації, грн/т', value: 7500, min: 0.01, help: 'Ціна має бути більшою за нуль.' },
    { id: 'area', label: 'Площа, га', value: 50, min: 0.01, help: 'Площа для оцінки загальних витрат.' },
  ],
  'spray-cost': [
    { id: 'rate', label: 'Норма продукту, л/га або кг/га', value: 1, min: 0, help: 'Одиниця має збігатися з одиницею ціни.' },
    { id: 'price', label: 'Ціна за 1 л або 1 кг, грн', value: 650, min: 0, help: 'Введіть ціну за ту саму одиницю.' },
    { id: 'area', label: 'Площа обробки, га', value: 50, min: 0.01, help: 'Площа, яку потрібно обробити.' },
  ],
  'tank-concentration': [
    { id: 'dosePer100L', label: 'Норма продукту на 100 л, мл або г', value: 100, min: 0, help: 'Не змішуйте мл і г: дотримуйтесь одиниці маркування.' },
    { id: 'volume', label: 'Загальний об’єм води, л', value: 600, min: 0.01, help: 'Загальний обсяг робочої суміші.' },
    { id: 'tankCapacity', label: 'Місткість бака, л', value: 300, min: 0.01, help: 'Об’єм одного бака.' },
  ],
  'machinery-cost': [
    { id: 'fuelRate', label: 'Витрата пального, л/га', value: 12, min: 0, help: 'Фактична або планова витрата.' },
    { id: 'fuelPrice', label: 'Ціна пального, грн/л', value: 55, min: 0, help: 'Ціна власної закупівлі.' },
    { id: 'otherCost', label: 'Інші витрати, грн/га', value: 500, min: 0, help: 'Введіть інші витрати без подвійного обліку.' },
    { id: 'area', label: 'Площа робіт, га', value: 50, min: 0.01, help: 'Площа запланованої операції.' },
  ],
  'rate-conversion': [
    { id: 'rate', label: 'Норма, кг/га', value: 100, min: 0, help: 'Задайте значення для перерахунку одиниць.' },
  ],
  'grain-revenue': [
    { id: 'yield', label: 'Урожайність, т/га', value: 5, min: 0.001, help: 'Фактичний результат або сценарій.' },
    { id: 'price', label: 'Ціна реалізації, грн/т', value: 8000, min: 0, help: 'Власна ціна або сценарне припущення.' },
    { id: 'area', label: 'Площа, га', value: 50, min: 0.01, help: 'Площа для підрахунку валового доходу.' },
  ],
  'nutrient-cost': [
    { id: 'price', label: 'Ціна добрива, грн/т', value: 25000, min: 0.01, help: 'Ціна тонни конкретного продукту.' },
    { id: 'nutrientContent', label: 'Вміст речовини, %', value: 46, min: 0.01, max: 100, help: 'Відсоток саме тієї речовини, яку порівнюєте.' },
  ],
};
const cropExamples: Record<string, Record<string, number>> = {
  'norma-vysivu-pshenytsi': { targetDensity: 450, thousandSeedMass: 40, germination: 95, purity: 99, fieldGermination: 85, rowSpacing: 15 },
  'norma-vysivu-soniashnyku': { targetDensity: 6, thousandSeedMass: 60, germination: 95, purity: 99, fieldGermination: 90, rowSpacing: 70 },
  'norma-vysivu-kukurudzy': { targetDensity: 7.5, thousandSeedMass: 300, germination: 95, purity: 99, fieldGermination: 90, rowSpacing: 70 },
  'norma-vysivu-ripaku': { targetDensity: 50, thousandSeedMass: 5, germination: 95, purity: 99, fieldGermination: 85, rowSpacing: 12 },
};
const examples = cropExamples[slug] ?? {};
const fields = (fieldSets[kind] ?? []).map((field) => examples[field.id] === undefined ? field : { ...field, value: examples[field.id] });
---
<div class="calculator-shell">
  <form class="calculator-card" data-calculator={kind} novalidate>
    <h2>Введіть параметри</h2>
    <p class="helper">Початкові значення наведено як приклад. Замініть їх даними вашого господарства.</p>
    <div class="field-grid">
      {fields.map((field) => <div class="field">
        <label for={field.id}>{field.label}</label>
        <input id={field.id} name={field.id} data-field={field.id} type="number" min={field.min ?? 0} max={field.max} step={field.step ?? 'any'} value={field.value} required />
        <small>{field.help}</small>
      </div>)}
    </div>
    <div class="calculator-actions">
      <button class="button-primary" type="submit">Розрахувати</button>
      <button class="button-secondary" type="reset">Очистити поля</button>
    </div>
    <p class="helper" style="margin: .85rem 0 0;">Розрахунок виконується у браузері. Значення не надсилаються на сервер.</p>
  </form>
  <section class="results-card" aria-labelledby={`${kind}-result-title`}>
    <h2 id={`${kind}-result-title`}>Результат розрахунку</h2>
    <div data-output><p class="results-placeholder">Перевірте прикладові значення та натисніть «Розрахувати».</p></div>
    <p class="result-status" data-status role="status" aria-live="polite"></p>
  </section>
</div>
<section class="history-card" data-history>
  <h2>Останні розрахунки на цьому пристрої</h2>
  <p class="helper">Історія зберігається лише в локальному сховищі браузера. Вона не передається на сервер і не синхронізується між пристроями.</p>
  <div data-history-list><p class="results-placeholder">Після першого розрахунку тут з’явиться історія.</p></div>
  <button class="button-secondary" type="button" data-clear-history>Очистити історію</button>
</section>
