---
import type { AgroTool } from '../data/tools';
const { tool } = Astro.props as { tool: AgroTool };
---
<a class="tool-card" href={`/kalkulyatory/${tool.slug}/`} data-tool-card data-search={`${tool.title} ${tool.shortTitle} ${tool.description} ${tool.keywords.join(' ')}`.toLowerCase()}>
  <div class="tool-card-top">
    <span class="tool-icon" aria-hidden="true">{tool.icon}</span>
    <span class="tool-arrow" aria-hidden="true">↗</span>
  </div>
  <h3>{tool.title}</h3>
  <p>{tool.cardDescription}</p>
  <span class="tool-meta">{tool.category} · Відкрити калькулятор</span>
</a>
